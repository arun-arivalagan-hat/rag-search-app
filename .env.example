# Copy to .env and fill in. Real environment variables always override .env.

# --- Answer generation, through OpenRouter (one key, many models) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# --- Local models (downloaded from Hugging Face on first use) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Paths (optional; default to the repo layout) ---
# RAG_DATA_DIR=./data
